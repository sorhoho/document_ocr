# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenTyphoon API key (https://opentyphoon.ai — free for research)
TYPHOON_API_KEY=your-typhoon-api-key-here

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model names
TYPHOON_OCR_MODEL=scb10x/typhoon-ocr1.5-3b
GEMMA_STRUCT_MODEL=gemma3:4b

# Preprocessing
PDF_DPI=300
VLM_MAX_SIDE_PX=1800
DESKEW_ENABLED=true

# Evaluation
CPU_COST_PER_HOUR_USD=0.05
LLM_JUDGE_ENABLED=true
